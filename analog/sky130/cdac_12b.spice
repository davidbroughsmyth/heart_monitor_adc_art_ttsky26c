XR2_6b m6 n6 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR6 n6 n7 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08

XR2_7a snk7 m7 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR2_7b m7 n7 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR7 n7 n8 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08

XR2_8a snk8 m8 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR2_8b m8 n8 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR8 n8 n9 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08

XR2_9a snk9 m9 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR2_9b m9 n9 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR9 n9 n10 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08

XR2_10a snk10 m10 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR2_10b m10 n10 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
XR10 n10 dac_out gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08

XR2_11a snk11 m11 gnd sky130_fd_pr__res_xhigh_po_0p35 l=9.08
